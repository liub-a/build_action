# zs_pdf_format_converter 非敏感构建配置（敏感信息走 GitHub Secrets，见 README.md）
PRODUCT_NAME=zs_pdf_format_converter
REPO_URL=code.zsrhkj.com/zsrhkj/Zs.PdfFormatConverter.git
DEFAULT_REF=master
# macOS 暂不对外发布，故不含 macos runner（也省 10 倍计费分钟）
PLATFORMS=win-x64,linux-x64
BUILD_LINUX=scripts/build-linux.sh
BUILD_WIN=scripts/windows/build-installer.bat
ARTIFACT_GLOB=src/Zs.PdfFormatConverter.Desktop/src-tauri/target/release/bundle/**,artifacts/windows-installer/**
VERSION_SOURCE=src/Zs.PdfFormatConverter.Desktop/src-tauri/tauri.conf.json
DOTNET_VERSION=8.0.x
NODE_VERSION=22
RUST_TOOLCHAIN=stable
# 本产品特有：Zs.OfdLite.Core / Zs.OfdLite.Render 是自研私有包，不在 nuget.org 上，
# 随产品仓库带着（在 packages/local/），产品仓库的 nuget.config 用相对路径指向它。
# CI 机器上没有开发机的绝对路径，靠这个才能 restore 成功。
LOCAL_NUGET_SOURCE=packages/local
