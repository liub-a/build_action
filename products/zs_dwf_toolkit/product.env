# zs_dwf_toolkit 非敏感构建配置（敏感信息走 GitHub Secrets，见 README.md）
PRODUCT_NAME=zs_dwf_toolkit
REPO_URL=code.zsrhkj.com/zsrhkj/Zs.DWFToolkit.git
DEFAULT_REF=master
# macOS 不在 matrix：macos runner 10 倍计费；仓库里已提交的 osx-arm64 / osx-x64 原生库照常打进包
# （osx-x64 在 Apple Silicon 上交叉编译）。要改由 CI 构建 mac 时再加 macos-14。
PLATFORMS=linux-x64,linux-arm64,win-x64
# 每个平台同一个脚本：自动识别 / 由 ZS_RID 指定 RID，编译后 stage 到 native-prebuilt/<rid>/
BUILD_LINUX=scripts/build-native-release.sh
BUILD_WIN=scripts/build-native-release.sh
ARTIFACT_GLOB=src/native-prebuilt/*/,src/artifacts/nuget/*
VERSION_SOURCE=src/Zs.DWFToolkit/Zs.DWFToolkit.csproj
DOTNET_VERSION=8.0.x
