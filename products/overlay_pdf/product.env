# overlay_pdf 非敏感构建配置（敏感信息走 GitHub Secrets，见 README.md）
PRODUCT_NAME=overlay_pdf
REPO_URL=code.zsrhkj.com/zsrhkj/OverlayPdfBatch.git
DEFAULT_REF=main
PLATFORMS=win-x64,osx-arm64,linux-x64
BUILD_WIN=scripts/release-win-full.bat
BUILD_MAC=scripts/build-mac.sh
BUILD_LINUX=scripts/build-linux.sh
# 只收最终安装包，不收解包目录（几百个 DLL）。
# Windows 当前发版只需 Setup.exe + MSI（upload-oss.bat 也只传这两个，Velopack 那套已停用）。
ARTIFACT_GLOB=build/publish/*.dmg,build/publish/*.deb,build/publish/*.rpm,build/publish/*.tar.gz,build/publish/msi/*.msi,build/publish/installer/OverlayPdf-Setup-*.exe,build/publish/EDITION.txt
VERSION_SOURCE=OverlayPdfApplication/OverlayPdfApplication/OverlayPdfApplication.csproj
DOTNET_VERSION=8.0.x
# 本产品特有：一套代码两个版本（cn 中国专版 / global 国际版），构建脚本读环境变量 EDITION。
# Windows 那条读的是 --global 参数（release-win-full.bat 内部再翻成 EDITION）。workflow 有对应输入。
EDITIONS=cn,global
