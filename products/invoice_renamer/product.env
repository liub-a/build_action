# invoice_renamer 非敏感构建配置（敏感信息走 GitHub Secrets，见 README.md）
PRODUCT_NAME=invoice_renamer
REPO_URL=code.zsrhkj.com/zsrhkj/InvoiceRenamer.git
DEFAULT_REF=master
# macOS 暂不对外发布，故不含 macos runner（也省 10 倍计费分钟）
PLATFORMS=win-x64,linux-x64
BUILD_LINUX=scripts/build-linux.sh
BUILD_WIN=scripts/windows/build-installer.bat
ARTIFACT_GLOB=src-tauri/target/release/bundle/**,artifacts/windows-installer/**
VERSION_SOURCE=src-tauri/tauri.conf.json
DOTNET_VERSION=8.0.x
NODE_VERSION=22
RUST_TOOLCHAIN=stable
