# zs_dwf_native_markup 非敏感构建配置（敏感信息走 GitHub Secrets，见 README.md）
PRODUCT_NAME=zs_dwf_native_markup
REPO_URL=code.zsrhkj.com/zsrhkj/Zs.DwfNativeMarkup.git
DEFAULT_REF=master
# macOS 暂不发布：macos runner 10 倍计费，且 Zs.DWFToolkit 包里没有 osx-x64 的 native。
# 要出 mac 包时加 macos-latest + bash scripts/release-mac.sh。
PLATFORMS=win-x64,linux-x64
BUILD_LINUX=scripts/build-linux.sh
BUILD_WIN=scripts/windows/build-installer.bat
ARTIFACT_GLOB=src/Zs.DwfNativeMarkup.Desktop/src-tauri/target/release/bundle/**,artifacts/windows-installer/**
VERSION_SOURCE=src/Zs.DwfNativeMarkup.Desktop/src-tauri/tauri.conf.json
DOTNET_VERSION=8.0.x
NODE_VERSION=22
RUST_TOOLCHAIN=stable
# 本产品特有：一套代码两个版本（cn 中国专版 / intl 国际版），构建脚本读环境变量 EDITION。
# workflow 里有对应的 edition 输入。
EDITIONS=cn,intl
