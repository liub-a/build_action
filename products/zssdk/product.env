# zssdk 非敏感构建配置（敏感信息走 GitHub Secrets，见 README.md）
PRODUCT_NAME=zssdk
REPO_URL=code.zsrhkj.com/zsrhkj/zssdk.git
DEFAULT_REF=main
# 产物是 C ABI 共享库（libzs），只发二进制、不发源码
PLATFORMS=darwin-arm64,linux-x64,linux-arm64
BUILD_SCRIPT=scripts/build-c-shared.sh
BUILD_MODE=c-shared
GO_VERSION=1.26.0
GLIBC_MAX=2.31
PDFIUM_VERSION=chromium/8111
ARTIFACT_GLOB=out/*.tar.gz
VERSION_SOURCE=csdk/main.go
